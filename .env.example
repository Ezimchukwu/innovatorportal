# Environment Variables Example
# Copy this file to .env.local for development with Vercel functions

# Supabase Configuration (Public - Safe for Frontend)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Paystack Configuration (Server-Side Only)
# CRITICAL: PAYSTACK_SECRET_KEY should NEVER be exposed in the frontend
# Set this only in Vercel's environment variables dashboard or via CLI
# PAYSTACK_SECRET_KEY="sk_live_your_secret_key_here"
